{
  "name": "meeting-memory",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/audit-dist.mjs dist",
    "build:fixtures": "npm run typecheck && vite build --mode foundation-mock && node scripts/audit-dist.mjs dist-dev",
    "build:chunk-test": "npm run typecheck && vite build --mode chunk-test && node scripts/audit-dist.mjs dist-chunk-test",
    "build:diagnostic": "npm run typecheck && vite build --mode transcription-diagnostic && node scripts/audit-dist.mjs dist-diagnostic",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:idb:edge": "node scripts/test-idb-edge.mjs",
    "test:watch": "vitest",
    "audit:dist": "node scripts/audit-dist.mjs dist"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
